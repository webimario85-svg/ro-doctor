{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webimario85-svg/ro-doctor/blob/main/docs/test-case.schema.json",
  "title": "RO Doctor external QA test-case evidence artifact v1",
  "description": "Reported outcome tied to exact binary hashes; never independent compatibility certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "scenario", "client_sha256",
    "server_build_sha256", "status", "observed_at", "runner",
    "log_sha256", "source_url"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "scenario": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "client_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "server_build_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "status": {"enum": ["pass", "fail", "unverified"]},
    "observed_at": {"type": "string", "format": "date"},
    "runner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _./-]{2,79}$"},
    "log_sha256": {"oneOf": [
      {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
      {"type": "null"}
    ]},
    "source_url": {"type": "string", "maxLength": 300, "pattern": "^https://"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["pass", "fail"]}}},
      "then": {"properties": {"log_sha256": {"type": "string"}}}
    }
  ]
}
